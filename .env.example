# ============================================================
# Delta — Environment Variables Configuration
# ============================================================
# Copy this file to `.env.local` or `.env` and fill in your API keys.

GROQ_API_KEY=gsk_your_groq_api_key_here

# Model selection (Defaults to GPT OSS / fast versatile models)
GROQ_MODEL=openai/gpt-oss-120b

BETTER_AUTH_SECRET=your_random_auth_secret_key_change_in_production
BETTER_AUTH_URL=http://localhost:3000

BRIGHT_DATA_API_KEY=your_bright_data_api_key_here
# Zone name from your Bright Data dashboard (default: web_unlocker1)
BRIGHT_DATA_ZONE=web_unlocker1
